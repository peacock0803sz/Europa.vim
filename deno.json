{
  "tasks": {
    "fmt:check": "deno fmt --check",
    "lint": "deno lint && deno run --allow-read --allow-env scripts/lint-no-handwritten-types.ts && deno run --allow-read scripts/lint-spec-id-bijection.ts && deno run --allow-read scripts/lint-no-color-literal.ts",
    "validate": "deno check schema/ contracts/ denops/europa/",
    "gen:vimdoc": "deno run --allow-read --allow-write --allow-run scripts/gen-vimdoc.ts",
    "test:fixtures": "deno run --allow-read --allow-env scripts/validate-fixtures.ts",
    "test:spec": "deno test --allow-read --allow-write --allow-run --allow-net --allow-env --ignore=tests/spec/notebook/serialize_spec.ts 'tests/spec/**/*_spec.ts'",
    "check": "deno task fmt:check && deno task lint && deno task validate && deno task gen:vimdoc && deno task test:fixtures && deno task test:spec && deno task test:golden && git diff --exit-code doc/europa-api.txt",
    "test:golden": "deno test --allow-read 'tests/spec/notebook/serialize_spec.ts'",
    "bench": "deno bench --allow-read tests/bench/",
    "smoke:ipynb": "deno run --allow-read scripts/smoke-ipynb.ts tests/fixtures/hello.ipynb",
    "test:conformance": "deno test --parallel --allow-run --allow-net --allow-read --allow-env 'tests/conformance/**/*_spec.ts'"
  },
  "imports": {
    "@denops/std": "jsr:@denops/std@^8.2.0",
    "@denops/std/batch": "jsr:@denops/std@^8.2.0/batch",
    "@lambdalisue/ansi-escape-code": "jsr:@lambdalisue/ansi-escape-code@^1.0.4",
    "@sinclair/typebox": "npm:@sinclair/typebox@^0.34.49",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/async": "jsr:@std/async@^1.3.0",
    "@std/cache": "jsr:@std/cache@^0.2.0",
    "@std/cli": "jsr:@std/cli@^1.0.29",
    "@std/encoding": "jsr:@std/encoding@^1.0.10",
    "@std/fs": "jsr:@std/fs@^1.0.23",
    "@std/path": "jsr:@std/path@^1.1.4",
    "@std/testing": "jsr:@std/testing@^1.0.18",
    "@std/uuid": "jsr:@std/uuid@^1.1.1",
    "typedoc": "npm:typedoc@^0.28.19",
    "typedoc-plugin-markdown": "npm:typedoc-plugin-markdown@^4.11.0",
    "typescript": "npm:typescript@^6.0.3"
  },
  "nodeModulesDir": "auto",
  "fmt": {
    "include": ["**/*.ts", "**/*.js", "**/*.json", "**/*.jsonc"],
    "exclude": [
      "doc/europa-api.txt",
      "tests/fixtures/",
      "specs/",
      ".specify/",
      ".claude/"
    ]
  },
  "lint": {
    "include": ["**/*.ts", "**/*.js"],
    "exclude": ["specs/", ".specify/", ".claude/"]
  }
}
