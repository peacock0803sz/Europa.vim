{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": false,
    "declaration": true
  },
  "include": [
    "denops/**/*.ts",
    "scripts/**/*.ts",
    "schema/**/*.ts",
    "contracts/**/*.ts"
  ],
  "exclude": ["specs", ".specify", ".claude", "node_modules"]
}
