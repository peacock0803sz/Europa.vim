{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": false,
    "paths": {
      "@denops/std": ["./typings/denops-std.d.ts"],
      "@denops/std/batch": ["./typings/denops-std-batch.d.ts"],
      "@std/uuid": ["./typings/std-uuid.d.ts"],
      "@std/async": ["./typings/std-async.d.ts"],
      "@std/encoding/base64": ["./typings/std-encoding-base64.d.ts"],
      "@std/encoding/hex": ["./typings/std-encoding-hex.d.ts"],
      "@std/cache/lru-cache": ["./typings/std-cache-lru-cache.d.ts"],
      "@std/path/join": ["./typings/std-path-join.d.ts"],
      "@std/fs/exists": ["./typings/std-fs-exists.d.ts"],
      "@std/cli/parse-args": ["./typings/std-cli-parse-args.d.ts"],
      "@std/async/delay": ["./typings/std-async-delay.d.ts"],
      "@lambdalisue/ansi-escape-code": [
        "./typings/lambdalisue-ansi-escape-code.d.ts"
      ]
    }
  },
  "include": [
    "denops/**/*.ts",
    "schema/**/*.ts",
    "contracts/**/*.ts",
    "typings/**/*.d.ts"
  ],
  "exclude": ["specs", ".specify", ".claude", "node_modules"]
}
