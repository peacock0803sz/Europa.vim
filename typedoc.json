{
  "$schema": "https://typedoc.org/schema.json",
  "name": "Europa.vim",
  "entryPoints": ["denops/europa", "schema", "contracts"],
  "entryPointStrategy": "expand",
  "out": "tmp/typedoc-out",
  "plugin": ["typedoc-plugin-markdown"],
  "readme": "none",
  "excludePrivate": true,
  "excludeInternal": true,
  "tsconfig": "tsconfig.json",
  "blockTags": [
    "@spec-id",
    "@param",
    "@returns",
    "@throws",
    "@example",
    "@see",
    "@deprecated",
    "@since",
    "@default",
    "@remarks",
    "@module",
    "@category",
    "@packageDocumentation"
  ]
}
